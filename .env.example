# ── Supabase Postgres ──────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# Use the "Session mode" pooler (port 5432) for both in Vercel serverless
DATABASE_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"
DIRECT_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres"

# ── Session secret ─────────────────────────────────────────────────────────────
# 32+ random bytes, e.g.: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# ── Firebase (client-side) ─────────────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123"

# ── Firebase Admin (server-side) ───────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com"
# Paste the private key exactly as-is (including \n newlines), wrapped in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Demo mode ──────────────────────────────────────────────────────────────────
# Set to a private value to enable the throwaway /demo login. If UNSET, demo
# mode is disabled entirely (fail closed). Never commit the real value.
DEMO_CODE="choose-a-private-code"

# ── Realtime (PartyKit) auth ────────────────────────────────────────────────────
# Shared secret the /api/pages/[id]/collab-token endpoint signs with and the
# PartyKit server verifies. If unset, COLLAB_SECRET falls back to SESSION_SECRET.
# MUST also be set in the PartyKit environment:  partykit env add COLLAB_SECRET
# Deploy order: ship the token-sending client + set the party secret BEFORE
# deploying the party — it fails closed and will reject every socket otherwise.
COLLAB_SECRET="reuse-SESSION_SECRET-or-another-long-random-string"
