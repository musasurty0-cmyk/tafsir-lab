# ── Supabase Postgres ──────────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# Use the "Session mode" POOLER host (port 5432) for both.
#
# Not the direct `db.<project>.supabase.co` host, even though the dashboard
# still offers it. Supabase dropped IPv4 from direct connections, so that
# hostname now publishes an AAAA record and no A record:
#
#   nslookup -type=A    db.<project>.supabase.co   ->  no address
#   nslookup -type=AAAA db.<project>.supabase.co   ->  2a05:d018:...
#
# On any IPv4-only network — plenty of home ISPs, most CI runners — Node and
# Prisma cannot resolve it at all, and the failure reads
# "Can't reach database server", which looks like the database is down rather
# than unreachable-from-here. The pooler host is dual-stack and just works.
DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Session secret ─────────────────────────────────────────────────────────────
# 32+ random bytes, e.g.: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# ── Firebase (client-side) ─────────────────────────────────────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789:web:abc123"

# ── Firebase Admin (server-side) ───────────────────────────────────────────────
# Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com"
# Paste the private key exactly as-is (including \n newlines), wrapped in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── Demo mode ──────────────────────────────────────────────────────────────────
# Set to a private value to enable the throwaway /demo login. If UNSET, demo
# mode is disabled entirely (fail closed). Never commit the real value.
DEMO_CODE="choose-a-private-code"

# ── Realtime (PartyKit) auth ────────────────────────────────────────────────────
# Shared secret the /api/pages/[id]/collab-token endpoint signs with and the
# PartyKit server verifies. If unset, COLLAB_SECRET falls back to SESSION_SECRET.
# MUST also be set in the PartyKit environment:  partykit env add COLLAB_SECRET
# Deploy order: ship the token-sending client + set the party secret BEFORE
# deploying the party — it fails closed and will reject every socket otherwise.
COLLAB_SECRET="reuse-SESSION_SECRET-or-another-long-random-string"

# ══ Optional ═══════════════════════════════════════════════════════════════════
# Everything below has a working default. They are listed because leaving them
# unset fails QUIETLY — the app builds, boots and looks fine, and only the one
# feature is dead. That is the expensive kind of missing config, so it is worth
# seeing the whole set in one place.

# ── Realtime host override ─────────────────────────────────────────────────────
# Defaults to localhost:1999 in development and the deployed party in
# production, so it is only needed to point at a different party.
# NEXT_PUBLIC_PARTYKIT_HOST="my-party.username.partykit.dev"

# ── Waitlist notification email (Resend) ───────────────────────────────────────
# UNSET = signups are still stored, but no email is sent and the endpoint
# reports success either way, so nothing surfaces the fact that nobody is
# being notified. WAITLIST_FROM needs a Resend-verified sender; without it the
# shared onboarding domain is used, which works but is rate-limited.
# RESEND_API_KEY="re_..."
# WAITLIST_FROM="TafsirLab <hello@your-domain.com>"

# ── Firebase auth proxy target ─────────────────────────────────────────────────
# Defaults to <NEXT_PUBLIC_FIREBASE_PROJECT_ID>.firebaseapp.com. Only set this
# if the project uses a non-default auth host. See next.config.ts for why the
# proxy exists at all (iOS/WebKit storage partitioning breaks sign-in without it).
# FIREBASE_AUTH_PROXY_TARGET="your-project.firebaseapp.com"

# ── Seed data IDs (local development only) ─────────────────────────────────────
# Printed by `npm run db:seed` — paste them back here. DEFAULT_WORKSPACE_ID
# backs the legacy /workspace/[surah_id] route; DEFAULT_USER_ID is read by
# prisma/seed-pages.ts, which throws without it.
# DEFAULT_USER_ID="..."
# DEFAULT_WORKSPACE_ID="..."
