{
  "name": "tafsir-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "node scripts/copy-mupdf-wasm.mjs && node scripts/write-build-id.mjs",
    "build": "prisma generate && node scripts/copy-mupdf-wasm.mjs && node scripts/write-build-id.mjs && next build",
    "start": "next start",
    "check:email": "node scripts/check-email.mjs",
    "waitlist": "npx tsx scripts/waitlist.mjs",
    "waitlist:digest": "npx tsx scripts/waitlist-digest.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:seed-minimal": "npx tsx prisma/seed-minimal.ts",
    "db:seed-pages": "npx tsx prisma/seed-pages.ts",
    "db:reset-product": "npx tsx prisma/reset-product.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "tafsir:ingest": "npx tsx scripts/ingest-tafsir.ts",
    "tafsir:sources": "npx tsx scripts/ingest-tafsir.ts --list-sources",
    "party:dev": "partykit dev",
    "party:deploy": "partykit deploy",
    "trailer:studio": "remotion studio remotion/index.ts",
    "trailer:render": "remotion render remotion/index.ts Trailer public/trailer.mp4 --codec=h264",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "prisma": {
    "seed": "npm run db:seed"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@prisma/client": "^5.22.0",
    "@tiptap/core": "^2.10.3",
    "@tiptap/extension-collaboration": "^2.27.2",
    "@tiptap/extension-collaboration-cursor": "^2.26.2",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.10.3",
    "@tiptap/extension-subscript": "^2.27.2",
    "@tiptap/extension-superscript": "^2.27.2",
    "@tiptap/extension-table": "^2.27.2",
    "@tiptap/extension-table-cell": "^2.27.2",
    "@tiptap/extension-table-header": "^2.27.2",
    "@tiptap/extension-table-row": "^2.27.2",
    "@tiptap/extension-task-item": "^2.27.2",
    "@tiptap/extension-task-list": "^2.27.2",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/pm": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "@tiptap/suggestion": "^3.22.4",
    "@types/pdf-parse": "^1.1.5",
    "firebase": "^12.12.1",
    "firebase-admin": "^13.8.0",
    "jose": "^6.2.2",
    "lucide-react": "^0.468.0",
    "mupdf": "^1.28.0",
    "next": "^16.3.0",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.19",
    "pdf-parse": "^2.4.5",
    "perfect-freehand": "^1.2.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tldraw": "^4.5.9",
    "y-partykit": "^0.0.33",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.31",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.489",
    "@remotion/google-fonts": "^4.0.489",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.25",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.3.0",
    "remotion": "^4.0.489",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
