generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────────────────────
model User {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String   @unique
  firebaseUid String?  @unique // set on first Google sign-in
  name        String
  avatarUrl   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  // Opt-in to appearing on the public leaderboard. Default true because the
  // welcome modal asks explicitly on first run; a user who never sees that
  // modal (seeded, invited) can still turn it off in Settings.
  publicLeaderboard Boolean @default(true)
  // Annotations the user is aiming for each day. Drives the Daily Progress
  // ring and nothing else — missing it has no consequence.
  dailyGoal         Int     @default(10)

  ownedWorkspaces  Workspace[]            @relation("WorkspaceOwner")
  memberships      WorkspaceMember[]
  createdPages     Page[]                 @relation("PageCreatedBy")
  publishedPages   Page[]                 @relation("PagePublishedBy")
  notes            StructuredNote[]
  personalProgress PersonalAyahProgress[]
  groupChanges     GroupAyahProgress[]    @relation("GroupProgressChangedBy")
  pagePrefs        PageUserPrefs[]
  activityLogs     ActivityLog[]
  templates        PageTemplate[]
  pagePresence     PagePresence[]
  segments         QuranSegment[]         @relation("SegmentCreatedBy")
  connections      QuranConnection[]      @relation("ConnectionCreatedBy")
  bookmarks        Bookmark[]
  friendshipsSent  Friendship[]           @relation("FriendRequester")
  friendshipsRecvd Friendship[]           @relation("FriendAddressee")
  youthMajlis      YouthMajlisProgress?
  youthAssignments YouthMajlisAssignee[]
  arabicStates     ArabicLessonState[]
  arabicReviews    ArabicReview[]
  demoPresence     DemoPresence?
}

// ─────────────────────────────────────────────────────────────
// SOCIAL
//
// One row per pair, held in the direction it was requested. Storing a single
// directed row (rather than two mirrored ones) means "are these two friends"
// is one lookup with an OR, and an accept is an UPDATE rather than an insert
// that could half-fail. The unique pair is enforced on (requesterId,
// addresseeId); the reverse direction is rejected in the service, since a
// database constraint cannot express "either order".
// ─────────────────────────────────────────────────────────────
model Friendship {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requesterId String    @db.Uuid
  addresseeId String    @db.Uuid
  status      String    @default("pending") // 'pending' | 'accepted'
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  respondedAt DateTime? @db.Timestamptz(6)

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// ─────────────────────────────────────────────────────────────
// BOOKMARKS — a saved place, not a saved note.
//
// Deliberately loose: a bookmark points at a Page and optionally at a spot
// inside it (mushaf sheet, or surah:ayah). Nulls are meaningful — a bookmark
// with only a pageId is "this notebook page", which is what a blank board or
// an imported PDF needs.
// ─────────────────────────────────────────────────────────────
model Bookmark {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @db.Uuid
  pageId      String   @db.Uuid
  label       String
  surahNumber Int?
  ayahNumber  Int?
  mushafPage  Int?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// WORKSPACES
// ─────────────────────────────────────────────────────────────
model Workspace {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  type       String // 'private' | 'group'  (visibility)
  // 'study'  → 114-surah grid + a single blank board (default)
  // 'boards' → no surahs; several free blank boards (e.g. a weekly class)
  // 'books'  → no surahs; a library of PDFs to annotate around (book study)
  // 'nawawi' → the forty-two hadith of al-Arbaʿūn an-Nawawiyya
  // 'arabic' → an Arabic course's flashcard decks (prisma/sql/014)
  kind       String   @default("study")
  ownerId    String   @db.Uuid
  avatarUrl  String?
  // A single glyph shown in the rail instead of the workspace's initials.
  // Auto-assigned at creation so a new workspace is never anonymous; the
  // owner can change it, or clear it to fall back to initials.
  icon       String?
  inviteCode String?  @unique
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  // Permission policy: when true, members (not just admins) may create,
  // rename, and delete pages. Default false = admins manage page structure.
  membersCanManagePages Boolean @default(false)

  // Each member has their own Mushaf board per page, seen only by them and the
  // admins; admins alone write on the shared one; no private text notes for
  // members (prisma/sql/025, the Youth Majlis cohort).
  privateBoards Boolean @default(false)

  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members     WorkspaceMember[]
  surahs      WorkspaceSurah[]
  activityLog ActivityLog[]
  segments    QuranSegment[]
  connections QuranConnection[]
  arabicLessons ArabicLesson[]
}

model WorkspaceMember {
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  role        String // 'owner' | 'admin' | 'member'
  joinedAt    DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

// ─────────────────────────────────────────────────────────────
// TEMPLATES
// ─────────────────────────────────────────────────────────────
model PageTemplate {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  surahNumber Int? // null = universal
  // [{ title: string, orderIndex: number, isAdminAuthored: boolean }]
  structure   Json
  isSystem    Boolean  @default(false)
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  createdBy       User?            @relation(fields: [createdById], references: [id])
  workspaceSurahs WorkspaceSurah[]
  derivedPages    Page[]
}

// ─────────────────────────────────────────────────────────────
// SURAH SESSIONS
// ─────────────────────────────────────────────────────────────
model WorkspaceSurah {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  surahNumber Int
  templateId  String?  @db.Uuid
  startedAt   DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  template  PageTemplate? @relation(fields: [templateId], references: [id])
  pages     Page[]

  @@unique([workspaceId, surahNumber])
}

// ─────────────────────────────────────────────────────────────
// SEGMENTS — user-defined ranges of consecutive ayat studied as one unit
// ─────────────────────────────────────────────────────────────

model QuranSegment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  surahNumber Int
  // Inclusive, consecutive, and within ONE surah. Disjoint ranges and
  // cross-surah spans are deliberately out of scope for now; overlapping
  // segments ARE allowed, so there is no exclusion constraint here.
  startAyah   Int
  endAyah     Int
  name        String
  description String?
  color       String?
  // Display order in the segment list only. Never affects Qur'anic order.
  sortOrder   Int      @default(0)
  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("SegmentCreatedBy", fields: [createdById], references: [id])

  // The common read is "every segment for this surah in this workspace".
  @@index([workspaceId, surahNumber])
}

// ─────────────────────────────────────────────────────────────
// CONNECTIONS — munasabat: relationships between Qur'anic objects
// ─────────────────────────────────────────────────────────────

model QuranConnection {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String @db.Uuid

  // Stable object keys, never display labels: "ayah:67:1", "surah:67",
  // "selection:<uuid>". A label can be renamed; these cannot drift.
  sourceType String // 'ayah' | 'selection' | 'surah'
  sourceKey  String
  targetType String
  targetKey  String

  // The two endpoint keys sorted and joined. A Connection is bidirectional, so
  // A->B and B->A are the SAME relationship; sorting collapses them to one
  // value and the unique index below makes the database — not the client —
  // the thing that prevents a reversed duplicate, including under concurrent
  // creation from two devices.
  pairKey String

  name       String
  commentary String?
  category   String?
  tags       String[] @default([])

  createdById String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation("ConnectionCreatedBy", fields: [createdById], references: [id])

  // One Connection per pair of objects per workspace. Several observations
  // about the same pair belong in one commentary, not several edges.
  @@unique([workspaceId, pairKey])
  // "Every Connection touching this object" is the query every panel makes,
  // and it has to match either endpoint.
  @@index([workspaceId, sourceKey])
  @@index([workspaceId, targetKey])
  @@index([workspaceId, category])
  @@index([workspaceId, updatedAt])
}

// ─────────────────────────────────────────────────────────────
// PAGES
// ─────────────────────────────────────────────────────────────
model Page {
  id               String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceSurahId String @db.Uuid
  title            String
  /// When the page first got ink (sql 021); the ink itself is in its realtime room.
  inkAt            DateTime? @db.Timestamptz(6)
  orderIndex       Int
  // 'draft' | 'published' | 'archived'
  status           String @default("draft")
  tiptapContent    Json?

  // Book study: a page can BE a book (a PDF to annotate around). pdfUrl is a
  // static library path ("/books/slug.pdf") or the sentinel "local" for a PDF
  // the user uploaded (bytes live in the browser's IndexedDB, keyed by pageId).
  pdfUrl  String?
  pdfName String?

  // Signals admin-authored content is present on this page.
  // Does NOT prevent members from adding their own notes.
  // Full page lock is a separate future concept.
  isAdminAuthored Boolean @default(false)

  // Template lineage
  templateId      String? @db.Uuid
  templatePageIdx Int?

  // Authorship trail
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  publishedById String?   @db.Uuid
  publishedAt   DateTime? @db.Timestamptz(6)
  archivedAt    DateTime? @db.Timestamptz(6)

  workspaceSurah   WorkspaceSurah         @relation(fields: [workspaceSurahId], references: [id], onDelete: Cascade)
  template         PageTemplate?          @relation(fields: [templateId], references: [id])
  createdBy        User                   @relation("PageCreatedBy", fields: [createdById], references: [id])
  publishedBy      User?                  @relation("PagePublishedBy", fields: [publishedById], references: [id])
  notes            StructuredNote[]
  personalProgress PersonalAyahProgress[]
  groupProgress    GroupAyahProgress[]
  userPrefs        PageUserPrefs[]
  pagePresence     PagePresence[]
  bookmarks        Bookmark[]
}

// ─────────────────────────────────────────────────────────────
// AYAH PROGRESS — two tables, clean semantics
// ─────────────────────────────────────────────────────────────

// One record per (page, user, surah, ayah).
// User can freely set any status in any direction.
model PersonalAyahProgress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId      String   @db.Uuid
  userId      String   @db.Uuid
  surahNumber Int
  ayahNumber  Int
  // 'not_studied' | 'pending' | 'studied'
  status      String
  changedAt   DateTime @updatedAt @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId, surahNumber, ayahNumber])
}

// One record per (page, surah, ayah). Shared group state.
// Direction rules enforced in progress.service:
//   members  → can only advance (not_studied → pending → studied)
//   admin+   → can set any status
model GroupAyahProgress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId        String   @db.Uuid
  surahNumber   Int
  ayahNumber    Int
  status        String // 'not_studied' | 'pending' | 'studied'
  lastChangedBy String   @db.Uuid // accountability: who made the last change
  changedAt     DateTime @updatedAt @db.Timestamptz(6)

  page      Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  changedBy User @relation("GroupProgressChangedBy", fields: [lastChangedBy], references: [id])

  @@unique([pageId, surahNumber, ayahNumber])
}

// ─────────────────────────────────────────────────────────────
// STRUCTURED NOTES (anchored, searchable)
// ─────────────────────────────────────────────────────────────
model StructuredNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId       String   @db.Uuid
  authorId     String   @db.Uuid
  // 'text' | 'callout' | 'linguistic' | 'thematic' | 'ruling' | 'question'
  noteType     String
  // 'ayah' | 'word' | 'page' | 'segment' | 'surah'
  anchorType   String
  surahNumber  Int?
  ayahNumber   Int?
  wordPosition Int?
  // Set only when anchorType = 'segment'. Nullable and additive, so every
  // existing note row remains valid and the other anchor types are untouched.
  segmentId    String?  @db.Uuid
  // Which Mushaf page a canvas text box was placed on. anchorType 'page' means
  // "anchored to this Page row" — a whole surah — not to a sheet of the Mushaf,
  // so without this a box written on one page reappeared on every other page of
  // the surah. Drawings already scope this way by tagging each stroke.
  // Nullable: rows created before this column stay valid (see the filter in
  // ModeBPage for how they are treated).
  mushafPage   Int?
  // Ayah/word layers only: NULL = opened in the page, 'alone' = the ayah on
  // its own. Two separate writing spaces (prisma/sql/012).
  layerView    String?
  content      Json // TipTap JSON — rich text, full-text searchable
  // 'amber' | 'emerald' | 'sky' | 'rose' | null
  color        String?
  // Canvas geometry — used in Mode B, ignored in Mode A
  offsetX      Float    @default(40)
  offsetY      Float    @default(0)
  width        Float    @default(280)
  height       Float? // null = auto
  zIndex       Int      @default(0)
  isMinimized  Boolean  @default(false)
  // true → only admin+ can edit or delete
  isAdmin      Boolean  @default(false)
  // 'private' | 'workspace' | 'admin'
  visibility   String   @default("workspace")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// DRAWING LAYER (visual only, not searchable)
// DESIGN DECISION: each user owns their own layer per page.
// All layers are rendered together in the UI.
// No shared collaborative drawing layer in v1.
// ─────────────────────────────────────────────────────────────

// ─────────────────────────────────────────────────────────────
// PAGE USER PREFERENCES
// ─────────────────────────────────────────────────────────────
model PageUserPrefs {
  pageId         String @db.Uuid
  userId         String @db.Uuid
  // Ayah numbers this user has collapsed. Sole source of truth for note visibility.
  collapsedAyahs Int[]  @default([])
  // { x: number, y: number, zoom: number } — Mode B only
  canvasViewport Json?

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([pageId, userId])
}

// ─────────────────────────────────────────────────────────────
// ACTIVITY LOG
// ─────────────────────────────────────────────────────────────
model ActivityLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  userId      String   @db.Uuid
  action      String
  entityType  String
  entityId    String?  @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
}

// ─────────────────────────────────────────────────────────────
// TAFSIR INGESTION LAYER
//
// Three-table design:
//   TafsirSource   — catalog of sources (one row per tafsir book/API)
//   TafsirEntry    — the ingested content (one row per source × verse)
//   TafsirFetchJob — progress tracking for bulk ingestion runs
//
// The old TafsirCache model has been replaced by this layer.
// ─────────────────────────────────────────────────────────────

model TafsirSource {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Human-readable unique key, e.g. "ibn-kathir-en", "tabari-ar"
  slug       String   @unique
  name       String // "Ibn Kathīr (English)"
  nameArabic String? // "ابن كثير"
  language   String // ISO 639-1: "en" | "ar" | "ur" …
  // "api"    → fetched from a structured API (e.g. quran.com)
  // "scrape" → fetched by parsing an HTML page (e.g. tafsir.app)
  type       String
  // Source-specific config (varies by type):
  //   api:    { provider: "quran.com", tafsirId: 169 }
  //   scrape: { provider: "tafsir.app", slug: "tabari" }
  config     Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  entries   TafsirEntry[]
  fetchJobs TafsirFetchJob[]
}

model TafsirEntry {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId    String   @db.Uuid
  verseKey    String // "1:1"
  // Plain-text content (always present)
  content     String
  // HTML content as returned by the source (optional, may contain
  // formatting like <em> and footnotes — strip before display if needed)
  contentHtml String?
  fetchedAt   DateTime @default(now()) @db.Timestamptz(6)
  // Flagged true when a re-fetch found newer content; old row kept for audit
  isStale     Boolean  @default(false)

  source TafsirSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, verseKey])
}

model TafsirFetchJob {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String    @db.Uuid
  // 0 = whole-Quran job (all 114 surahs); 1–114 = single surah
  surahNumber     Int
  // "pending" | "running" | "done" | "failed"
  status          String    @default("pending")
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?
  recordsInserted Int       @default(0)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  source TafsirSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // One active job per source × surah at a time
  @@unique([sourceId, surahNumber])
}

// ─────────────────────────────────────────────────────────────
// PAGE PRESENCE (live collaboration — who is on the page)
// ─────────────────────────────────────────────────────────────
model PagePresence {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  pageId     String   @db.Uuid
  userId     String   @db.Uuid
  isTyping   Boolean  @default(false)
  cursorFrom Int?
  cursorTo   Int?
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
}

/// Waitlist signups from the public /waitlist page (linked from the IG bio).
/// The row is the source of truth: the notification email to the team is
/// best-effort, so a mail outage or a missing API key can never lose a signup.
model WaitlistSignup {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  /// free-text: how they study today / what they want from it
  context   String?
  /// where the click came from, e.g. "instagram-bio"
  source    String?
  /// whether the notification email actually went out
  notified  Boolean  @default(false)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Requests to join the CLOSED BETA, from /beta/request.
///
/// Separate from WaitlistSignup on purpose. A waitlist entry is "tell me when
/// it opens" and wants to stay one field long; this is an application, and the
/// answers are the whole point — they decide who gets a place. Keeping them in
/// their own columns means the cohort can actually be sorted and filtered
/// rather than read as prose.
model BetaRequest {
  id         String   @id @default(uuid())
  email      String   @unique
  name       String
  /// Nullable: asked for, but never a reason to reject a submission.
  age        Int?
  /// One of the buckets offered by the form, stored as its label.
  studyDaily String
  /// What they use today — apps, books, whatever.
  studyTools String
  /// What they expect TafsirLab to change for them.
  benefit    String
  /// Where the click came from, e.g. "instagram-bio".
  source     String?
  /// Whether the notification email to the team actually went out. False here
  /// with a row present means the request arrived but nobody was told.
  notified   Boolean  @default(false)
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// YOUTH MAJLIS — portal progress, synced to the student's account
// (prisma/sql/007_youth_majlis_progress.sql)
// ─────────────────────────────────────────────────────────────

model YouthMajlisProgress {
  userId      String   @id @db.Uuid
  // { "<key>": { "v": value, "at": ms } } — merged key by key on the newest "at"
  entries     Json     @default("{}")
  // The workspace "Open in TafsirLab" uses, pinned on first open
  workspaceId String?  @db.Uuid
  // 'student' | 'organiser' | 'left' (prisma/sql/008)
  role        String   @default("student")
  joinedAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One Majlis gathering (prisma/sql/008). Dates are UK calendar dates.
model YouthMajlisSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleN      Int
  seq          Int
  date         DateTime? @db.Date
  startTime    String?
  endTime      String?
  venue        String?
  ayahFrom     Int?
  ayahTo       Int?
  /// 'ayat' — āyah by āyah; 'points' — through the notes, point by point (prisma/sql/009)
  studyBy      String    @default("ayat")
  pointFrom    Int?
  pointTo      Int?
  /// [{ text: string }]
  prep         Json      @default("[]")
  prepDue      DateTime? @db.Date
  /// string[]
  takeaways    Json      @default("[]")
  recordingUrl String?
  followUp     String?
  /// [{ time: string, item: string }]
  agenda       Json      @default("[]")
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  assignments YouthMajlisAssignment[]
  packs       YouthMajlisPack[]

  @@unique([moduleN, seq])
  @@index([date])
}

/// Research set for a session: a point and/or an āyah range, for one or more students.
model YouthMajlisAssignment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String    @db.Uuid
  point     Int?
  ayahFrom  Int?
  ayahTo    Int?
  note      String?
  due       DateTime? @db.Date
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  session   YouthMajlisSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignees YouthMajlisAssignee[]

  @@index([sessionId])
}

model YouthMajlisAssignee {
  assignmentId String @db.Uuid
  userId       String @db.Uuid

  assignment YouthMajlisAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([assignmentId, userId])
}

/// Portal-wide settings, one row per key (announcement, cohort workspace).
model YouthMajlisSettings {
  id        String   @id
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// The compiled class notes, one row per module; 0 holds the sources (prisma/sql/010).
model YouthMajlisNote {
  moduleN   Int      @id
  data      Json     @default("{}")
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// A prep pack PDF for a session; the file is in R2, not here (prisma/sql/024).
model YouthMajlisPack {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId  String   @db.Uuid
  title      String
  fileName   String
  key        String   @unique
  bytes      Int
  ready      Boolean  @default(false)
  uploadedBy String?  @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  session YouthMajlisSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Prep pack links handed out per month, the free-tier guard (prisma/sql/024).
model YouthMajlisPackReads {
  month String @id
  count Int    @default(0)
}

/// Files the portal hands out (the class notes PDF), behind its password (prisma/sql/011).
model YouthMajlisFile {
  name        String   @id
  contentType String
  data        Bytes
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// The private timetable at /productivity (prisma/sql/013). One row per plan.
model ProductivityPlan {
  id           String   @id
  passwordHash String
  draft        Json
  state        Json?
  /// An Apple Calendar shared by link, shown alongside the plan (prisma/sql/023).
  calendarUrl  String?
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

/// An open demo checks in; closing it stamps closedAt (prisma/sql/009).
model DemoPresence {
  userId   String    @id @db.Uuid
  seenAt   DateTime  @default(now()) @db.Timestamptz(6)
  closedAt DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Arabic study (prisma/sql/014): one imported flashcard deck. `number` is
/// the course's lesson number, null for revision and preparation files.
model ArabicLesson {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  level       Int
  fileNo      Int
  number      Int?
  // 'lesson' | 'revision' | 'prep'
  kind        String   @default("lesson")
  title       String
  cardCount   Int      @default(0)
  /// The board (notes document + canvas) for this lesson, made on first open (sql 016).
  pageId      String?  @db.Uuid
  /// Set only on a reader's own "My words" (sql 017); course lessons are shared.
  ownerId     String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     ArabicCard[]
  states    ArabicLessonState[]

  @@unique([workspaceId, level, fileNo])
}

model ArabicCard {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId   String  @db.Uuid
  ord        Int
  grp        Int     @default(0)
  english    String
  arabic     String
  translit   String?
  // 'm' | 'f'
  gender     String?
  isSentence Boolean @default(false)
  /// The Arabic without ḥarakāt or letter variants, for search.
  folded     String

  lesson  ArabicLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  reviews ArabicReview[]

  @@index([lessonId, ord])
}

/// Where one reader is in one lesson: 'covered' | 'current'.
model ArabicLessonState {
  userId    String   @db.Uuid
  lessonId  String   @db.Uuid
  state     String
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson ArabicLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
}

/// One reader's memory of one card (prisma/sql/015, lib/arabic/srs).
/// box 0 not known, 1–4 learning, 5+ learnt. No row means not known.
model ArabicReview {
  userId String   @db.Uuid
  cardId String   @db.Uuid
  box    Int      @default(0)
  due    DateTime @default(now()) @db.Timestamptz(6)
  reps   Int      @default(0)
  lapses Int      @default(0)
  lastAt DateTime @default(now()) @db.Timestamptz(6)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card ArabicCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@id([userId, cardId])
  @@index([userId, due])
}

/// /dunya (prisma/sql/018): password hash, the A-level papers, and attempts.
/// The PDFs are in a private R2 bucket, served by the realtime worker.
model DunyaPlan {
  id           String   @id
  passwordHash String
  catalog      Json
  progress     Json?
  /// File links handed out in fileReadsMonth ("2026-10"): the R2 free-tier guard.
  fileReads      Int     @default(0)
  fileReadsMonth String?
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}
